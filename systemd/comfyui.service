[Unit]
Description=ComfyUI (GGUF models) — adjust User and paths to your system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/ComfyUI
ExecStart=/home/YOUR_USER/ComfyUI/venv/bin/python main.py --listen 0.0.0.0 --port 8188
Restart=always
RestartSec=10
StandardOutput=append:/home/YOUR_USER/comfyui.log
StandardError=append:/home/YOUR_USER/comfyui.log

[Install]
WantedBy=multi-user.target
