[Unit]
Description=ComfyBot Studio — Telegram bot (ComfyUI frontend)
After=network-online.target comfyui.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/comfy-tele-bot
EnvironmentFile=/home/YOUR_USER/comfy-tele-bot/.env
ExecStart=/home/YOUR_USER/comfy-tele-bot/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/YOUR_USER/bot.log
StandardError=append:/home/YOUR_USER/bot.log

[Install]
WantedBy=multi-user.target
