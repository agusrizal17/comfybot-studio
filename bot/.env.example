# Copy to .env and fill in your own values. Never commit the real .env.
BOT_TOKEN=123456:ABC-your-telegram-bot-token
ADMIN_ID=0
# Channel users must join before using the bot (bot must be an admin there).
CHANNEL_USERNAME=@yourchannel
# Per-user daily quotas (admin is exempt).
IMG_QUOTA=10
VID_QUOTA=3
